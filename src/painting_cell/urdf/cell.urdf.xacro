<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="painting_cell">
  <xacro:arg name="base_x" default="0.7"/>
  <xacro:arg name="base_y" default="-1.55"/>
  <xacro:arg name="base_z" default="0.65"/>
  <xacro:arg name="controllers" default="$(find painting_cell)/config/controllers.yaml"/>
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find ur_description)/urdf/inc/ur_joint_control.xacro"/>
  <link name="world"/>
  <xacro:ur_robot name="ur20" tf_prefix="" parent="world"
    joint_limits_parameters_file="$(find ur_description)/config/ur20/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/ur20/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/ur20/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/ur20/visual_parameters.yaml"
    force_abs_paths="true">
    <origin xyz="$(arg base_x) $(arg base_y) $(arg base_z)" rpy="0 0 0"/>
  </xacro:ur_robot>
  <link name="spray_nozzle">
    <visual><origin xyz="0 0 -0.10"/><geometry><cylinder radius="0.025" length="0.20"/></geometry><material name="nozzle"><color rgba="0.9 0.5 0.1 1"/></material></visual>
    <collision><origin xyz="0 0 -0.10"/><geometry><cylinder radius="0.025" length="0.20"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.10"/><mass value="0.5"/><inertia ixx="0.002" iyy="0.002" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="spray_tool_joint" type="fixed"><parent link="tool0"/><child link="spray_nozzle"/><origin xyz="0 0 0.20"/></joint>
  <ros2_control name="GazeboSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <xacro:ur_joint_control_description tf_prefix=""/>
  </ros2_control>
  <gazebo><plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin"><parameters>$(arg controllers)</parameters></plugin></gazebo>
</robot>
