<?xml version="1.0"?>
<sdf version="1.9"><world name="painting_cell">
  <physics name="physics" type="ignored"><max_step_size>0.002</max_step_size><real_time_factor>1.0</real_time_factor></physics>
  <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
  <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.16 0.19 0.24 1</background><shadows>true</shadows></scene>
  <light name="sun" type="directional"><pose>0 0 8 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.5 0.2 -1</direction><cast_shadows>true</cast_shadows></light>
  <model name="floor"><static>true</static><link name="floor">
    <collision name="floor"><pose>0 0 -0.05 0 0 0</pose><geometry><box><size>FLOOR_SIZE</size></box></geometry></collision>
    <visual name="floor"><pose>0 0 -0.05 0 0 0</pose><geometry><box><size>FLOOR_SIZE</size></box></geometry><material><diffuse>0.24 0.27 0.31 1</diffuse></material></visual>
  </link></model>
  <model name="pedestal"><static>true</static><pose>PEDESTAL_POSE</pose><link name="pedestal">
    <collision name="pedestal"><geometry><box><size>PEDESTAL_SIZE</size></box></geometry></collision>
    <visual name="pedestal"><geometry><box><size>PEDESTAL_SIZE</size></box></geometry><material><diffuse>0.3 0.4 0.5 1</diffuse></material></visual>
  </link></model>
  LAYOUT_MODELS
  <include><uri>model://hatchback</uri><name>car</name><pose>CAR_POSE 0 0 0</pose></include>
</world></sdf>
